    "group:blocked": [],
    "group:premium": [
      "user001@hs.local",
      "user002@hs.local"
    ]
  },
  "tagOwners": {
    "tag:exit-node": [
      "group:admins"
    ],
    "tag:server": [
      "group:admins"
    ],
    "tag:router": [
      "group:admins"
    ]
  },
  "acls": [
    {
      "action": "accept",
      "src": [
        "group:admins"
      ],
      "dst": [
        "*:*"
      ]
    },
    {
      "action": "accept",
      "src": [
        "group:users"
      ],
      "dst": [
        "tag:exit-node:*"
      ]
    },
    {
      "action": "accept",
      "src": [
        "group:premium"
      ],
      "dst": [
        "tag:exit-node:*",
        "tag:server:*"
      ]
    }
  ],
  "autoApprovers": {
    "routes": {
      "0.0.0.0/0": [
        "group:admins"
      ],
      "::/0": [
        "group:admins"
      ]
    },
    "exitNode": [
      "group:admins"
    ]
  },
  "ssh": [
    {
      "action": "accept",
      "src": [
        "group:admins"
      ],
      "dst": [
        "tag:server"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    }
  ],
  "tests": [
    {
      "src": "user001@hs.local",
      "deny": [
        "user002@hs.local:22"
      ]
    },
    {
      "src": "user001@hs.local",
      "accept": [
        "tag:exit-node:443"
      ]
    },
    {
      "src": "admin@hs.local",
      "accept": [
        "user003@hs.local:22"
      ]
    },
    {
      "src": "user003@hs.local",
      "deny": [
        "user003@hs.local:22"
      ]
    },
    {
      "src": "user050@hs.local",
      "deny": [
        "user049@hs.local:80"
      ]
    }
  ]
}
